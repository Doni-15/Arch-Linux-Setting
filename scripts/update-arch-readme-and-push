#!/usr/bin/env bash
set -euo pipefail

USER_NAME="doni-arch"
REPO_DIR="/home/${USER_NAME}/Arch-System"
LOG_FILE="/tmp/arch-readme-git-backup.log"
TMP_BRANCH="arch-system-snapshot-tmp"

echo "[$(date)] Starting Arch README snapshot backup..." >> "$LOG_FILE"

# Update README and package report
/usr/local/bin/update-arch-readme || true

# Backup automation files into repo too
mkdir -p "${REPO_DIR}/scripts" "${REPO_DIR}/hooks"

cp /usr/local/bin/update-arch-readme "${REPO_DIR}/scripts/update-arch-readme" 2>/dev/null || true
cp /usr/local/bin/update-arch-readme-and-push "${REPO_DIR}/scripts/update-arch-readme-and-push" 2>/dev/null || true
cp /etc/pacman.d/hooks/99-update-arch-readme.hook "${REPO_DIR}/hooks/99-update-arch-readme.hook" 2>/dev/null || true

chown -R "${USER_NAME}:${USER_NAME}" "$REPO_DIR"

# Create one clean snapshot commit with no old history
runuser -u "$USER_NAME" -- git -C "$REPO_DIR" checkout main >> "$LOG_FILE" 2>&1 || true
runuser -u "$USER_NAME" -- git -C "$REPO_DIR" branch -D "$TMP_BRANCH" >> "$LOG_FILE" 2>&1 || true
runuser -u "$USER_NAME" -- git -C "$REPO_DIR" checkout --orphan "$TMP_BRANCH" >> "$LOG_FILE" 2>&1

runuser -u "$USER_NAME" -- git -C "$REPO_DIR" rm -rf --cached . >> "$LOG_FILE" 2>&1 || true
runuser -u "$USER_NAME" -- git -C "$REPO_DIR" add -A

runuser -u "$USER_NAME" -- git -C "$REPO_DIR" commit -m "chore: Arch system snapshot $(date '+%Y-%m-%d %H:%M:%S')" >> "$LOG_FILE" 2>&1

runuser -u "$USER_NAME" -- git -C "$REPO_DIR" branch -M main >> "$LOG_FILE" 2>&1

# Push latest snapshot only
timeout 25s runuser -u "$USER_NAME" -- git -C "$REPO_DIR" push --force-with-lease -u origin main >> "$LOG_FILE" 2>&1 || {
    echo "[$(date)] GitHub push skipped/failed. Local snapshot is still safe." >> "$LOG_FILE"
    exit 0
}

# Clean local git history/object leftovers
runuser -u "$USER_NAME" -- git -C "$REPO_DIR" reflog expire --expire=now --all >> "$LOG_FILE" 2>&1 || true
runuser -u "$USER_NAME" -- git -C "$REPO_DIR" gc --prune=now --aggressive >> "$LOG_FILE" 2>&1 || true

echo "[$(date)] Snapshot backup completed." >> "$LOG_FILE"

exit 0
