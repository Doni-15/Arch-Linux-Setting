#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${ARCH_SNAPSHOT_CONFIG:-/etc/arch-snapshot.conf}"

if [[ ! -r "$CONFIG_FILE" ]]; then
    printf 'Konfigurasi tidak dapat dibaca: %s\n' "$CONFIG_FILE" >&2
    exit 1
fi

if [[ "$EUID" -eq 0 ]]; then
    config_owner="$(stat -c '%u' "$CONFIG_FILE")"
    config_mode="$(stat -c '%a' "$CONFIG_FILE")"

    if [[ "$config_owner" -ne 0 ]] || (( (8#$config_mode & 8#022) != 0 )); then
        printf 'Konfigurasi harus dimiliki root dan tidak writable oleh group/other.\n' >&2
        exit 1
    fi
fi

# shellcheck source=/dev/null
source "$CONFIG_FILE"

: "${SNAPSHOT_DIR:?SNAPSHOT_DIR wajib diisi pada konfigurasi}"

if [[ "$SNAPSHOT_DIR" != /* || "$SNAPSHOT_DIR" == "/" ]]; then
    printf 'SNAPSHOT_DIR harus berupa absolute path yang spesifik.\n' >&2
    exit 1
fi

SNAPSHOT_DIR="${SNAPSHOT_DIR%/}"
README="${SNAPSHOT_DIR}/README.md"

if [[ ! -d "${SNAPSHOT_DIR}/.git" || ! -f "$README" ]]; then
    printf 'SNAPSHOT_DIR harus menunjuk clone Git yang memiliki README.md.\n' >&2
    exit 1
fi

TEMP_DIR="$(mktemp -d)"
trap 'rm -rf -- "$TEMP_DIR"' EXIT

pacman -Qqen | LC_ALL=C sort > "${TEMP_DIR}/packages-explicit-official.txt"
pacman -Qqem | LC_ALL=C sort > "${TEMP_DIR}/packages-explicit-foreign.txt" || true
pacman -Qq | LC_ALL=C sort > "${TEMP_DIR}/packages-all.txt"
grep -E 'installed|removed|upgraded|reinstalled' /var/log/pacman.log \
    | tail -n 160 > "${TEMP_DIR}/pacman-recent.log" || true

official_count="$(wc -l < "${TEMP_DIR}/packages-explicit-official.txt")"
foreign_count="$(wc -l < "${TEMP_DIR}/packages-explicit-foreign.txt")"
all_count="$(wc -l < "${TEMP_DIR}/packages-all.txt")"

cat > "${TEMP_DIR}/auto-report.md" <<REPORT
<!-- AUTO_PACKAGE_REPORT_START -->
Snapshot dibuat pada \`$(date --iso-8601=seconds)\`.

| Jenis | Jumlah |
| --- | ---: |
| Package resmi eksplisit | ${official_count} |
| Package asing/AUR eksplisit | ${foreign_count} |
| Seluruh package | ${all_count} |

Kernel release: \`$(uname -r)\`.

Daftar lengkap tersedia pada file \`packages-*.txt\`; transaksi terbaru tersedia pada \`pacman-recent.log\`. Laporan tidak memasukkan hostname, username, UUID, disk layout, atau mount path.
<!-- AUTO_PACKAGE_REPORT_END -->
REPORT

awk -v block_file="${TEMP_DIR}/auto-report.md" '
    BEGIN {
        while ((getline line < block_file) > 0) {
            block = block line "\n"
        }
        close(block_file)
    }
    /<!-- AUTO_PACKAGE_REPORT_START -->/ {
        printf "%s", block
        skip = 1
        next
    }
    /<!-- AUTO_PACKAGE_REPORT_END -->/ {
        skip = 0
        next
    }
    skip != 1 { print }
' "$README" > "${TEMP_DIR}/README.md"

install -m 0644 "${TEMP_DIR}/packages-explicit-official.txt" \
    "${SNAPSHOT_DIR}/packages-explicit-official.txt"
install -m 0644 "${TEMP_DIR}/packages-explicit-foreign.txt" \
    "${SNAPSHOT_DIR}/packages-explicit-foreign.txt"
install -m 0644 "${TEMP_DIR}/packages-all.txt" \
    "${SNAPSHOT_DIR}/packages-all.txt"
install -m 0644 "${TEMP_DIR}/pacman-recent.log" \
    "${SNAPSHOT_DIR}/pacman-recent.log"
install -m 0644 "${TEMP_DIR}/README.md" "$README"

if [[ -n "${SNAPSHOT_OWNER:-}" ]]; then
    chown "$SNAPSHOT_OWNER:" \
        "$README" \
        "${SNAPSHOT_DIR}/packages-explicit-official.txt" \
        "${SNAPSHOT_DIR}/packages-explicit-foreign.txt" \
        "${SNAPSHOT_DIR}/packages-all.txt" \
        "${SNAPSHOT_DIR}/pacman-recent.log"
fi
